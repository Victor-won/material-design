{
  "name": "paperform-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "e2e": "node scripts/browser-check.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lucide/vue": "^1.73.0",
    "jspdf": "^4.2.1",
    "pinia": "^4.1.0",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
